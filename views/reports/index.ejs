<%- include('../partials/header') %>
<div class="pagehead"><div><h1>Reports</h1><div class="muted"><%= is('loan_officer') ? 'Loan Officers see their own customers.' : 'All branches and officers.' %> Every report exports to Excel and PDF.</div></div></div>
