<%- include('../partials/header') %>
<% const acc = JSON.parse(it.accessories || '[]'), checks = JSON.parse(it.intake_checks || '[]'); const held = ['in_store','for_sale','missing'].includes(it.custody_status); %>
<div class="pagehead">
  <div><h1><%= it.brand_name %> <%= it.model %> <span class="muted">· <%= it.item_no %></span></h1>
  <div class="muted"><%= cat.label %> · owner <a href="/customers/<%= c.id %>"><%= c.given_names %> <%= c.surname %></a> · <%- include('../partials/badge', { s: it.custody_status }) %></div></div>
  <div class="actions" style="margin:0"><a class="btn secondary" href="/items/<%= it.id %>/tag" target="_blank">Print tag</a></div>
</div>
<div class="grid g2">
<div class="panel"><h2>Description</h2>
  <dl class="kv small">
    <dt>Tag / barcode</dt><dd><img src="/items/<%= it.id %>/tag.png" alt="<%= it.item_no %>" style="height:48px"></dd>
    <dt>Year</dt><dd><%= it.year || '—' %></dd><dt>Colour</dt><dd><%= it.colour || '—' %></dd>
    <% if (it.category === 'car') { %>
      <dt>VIN / chassis</dt><dd class="mono"><%= it.vin %></dd><dt>Engine no.</dt><dd class="mono"><%= it.engine_no %></dd><dt>Plate</dt><dd class="mono"><%= it.plate %></dd>
      <dt>Odometer at intake</dt><dd><%= Number(it.mileage_intake).toLocaleString() %> km · fuel <%= it.fuel_intake %></dd>
      <% if (it.return_mileage) { %><dt>Odometer at return</dt><dd><%= Number(it.return_mileage).toLocaleString() %> km</dd><% } %>
    <% } else { %>
      <dt>Storage / RAM</dt><dd><%= it.storage %> / <%= it.ram %><%= it.processor ? ' · ' + it.processor : '' %></dd>
      <dt><%= it.category === 'phone' ? 'IMEI' : 'Serial no.' %></dt><dd class="mono"><%= it.imei || it.serial_no %></dd>
      <dt>Device password</dt><dd id="password"><% if (!it.device_password_enc) { %><span class="muted">None held</span><% } else if (password) { %><span class="mono" style="background:#ffd;padding:0 .3rem"><%= password %></span> <span class="small muted">(this view was logged)</span><% } else if (is('cro')) { %><form method="post" action="/items/<%= it.id %>/password" class="inline"><%- include('../partials/csrf') %><button class="btn small secondary">Show (CRO only, logged)</button></form><% } else { %>Encrypted — CRO only<% } %></dd>
    <% } %>
    <dt>Checks at intake</dt><dd><%= checks.join(' · ') %></dd>
    <dt>Accessories</dt><dd><%= acc.join(', ') || 'None' %></dd>
    <dt>Faults at intake</dt><dd><%= it.faults || 'None noted' %></dd>
    <dt>Proof of ownership</dt><dd><%= it.ownership_doc_type %> in the name of <strong><%= it.owner_name %></strong></dd>
  </dl>
</div>
<div class="panel"><h2>Custody</h2>
  <dl class="kv small">
    <dt>Branch</dt><dd><%= branchName %></dd><dt>Location</dt><dd><strong><%= it.location %></strong></dd>
    <% if (it.safe_location) { %><dt>Keys and papers</dt><dd><%= it.safe_location %> (safe)</dd><% } %>
    <dt>Received</dt><dd><%= fd(it.date_in) %></dd>
    <% if (it.returned_at) { %><dt>Returned</dt><dd><%= fts(it.returned_at) %> to <%= it.returned_to %>, ID shown: <%= it.return_id_shown %><%= it.return_note ? ' — ' + it.return_note : '' %></dd><% } %>
  </dl>
  <% if (held && is('loan_officer', 'cro')) { %>
  <details class="action" style="margin-top:.8rem"><summary>Move item</summary><div>
    <form method="post" action="/items/<%= it.id %>/move" class="f"><%- include('../partials/csrf') %>
      <div class="row"><div><label>New location</label><input name="to_location" required></div><% if (it.category === 'car') { %><div><label>Safe slot (keys/papers)</label><input name="safe_location" value="<%= it.safe_location || '' %>"></div><% } %></div>
      <label>Reason</label><input name="reason" required><div class="actions"><button class="btn small">Record move</button></div></form></div></details>
  <% } %>
  <% if (it.category === 'car' && held && is('loan_officer', 'cro')) { %>
  <details class="action"><summary>Record a viewing in the yard</summary><div>
    <p class="small muted">The owner may only look at the car in the yard with staff present.</p>
    <form method="post" action="/items/<%= it.id %>/viewing" class="f"><%- include('../partials/csrf') %><label>Visitor</label><input name="visitor" value="<%= c.given_names %> <%= c.surname %>" required><label>Note</label><input name="note"><div class="actions"><button class="btn small">Record viewing</button></div></form></div></details>
  <% } %>
  <% if (it.custody_status === 'missing' && is('cro')) { %>
  <form method="post" action="/items/<%= it.id %>/found" class="f"><%- include('../partials/csrf') %><label>Found at location</label><input name="location" value="<%= it.location %>"><div class="actions"><button class="btn small">Mark as found</button></div></form>
  <% } %>
  <% if (['returned','handed_back'].includes(it.custody_status) && is('loan_officer')) { %>
  <details class="action" style="margin-top:.8rem"><summary>Take in again for a new loan (repeat loan)</summary><div>
    <p class="small muted">A new loan with a new release date. Renewals are not allowed — the item must have been redeemed first.</p>
    <form method="post" action="/items/<%= it.id %>/reintake?_csrf=<%= csrf %>" enctype="multipart/form-data" class="f">
      <div class="row"><div><label>Location</label><input name="location" required></div>
      <% if (it.category === 'car') { %><div><label>Safe slot</label><input name="safe_location"></div><div><label>Odometer (km)</label><input name="mileage_intake" required></div><div><label>Fuel</label><input name="fuel_intake" required></div><% } %></div>
      <div class="row"><div><label>At least <%= minPhotos %> new photos</label><input type="file" name="photos" multiple accept="image/*" required></div><div><label>Photo of the <%= cat.extraPhoto %></label><input type="file" name="extra_photo" accept="image/*" required></div></div>
      <div class="actions"><button class="btn small">Take in again</button></div></form></div></details>
  <% } %>
</div>
</div>
<div class="panel"><h2>Photos and documents</h2>
  <div class="photos"><% photos.forEach(function (p) { %><a href="/files/<%= p.id %>" title="<%= p.kind %> <%= p.caption || '' %>"><% if (p.mime.startsWith('image/')) { %><img src="/files/<%= p.id %>" alt="<%= p.kind %>"><% } else { %><span class="badge"><%= p.kind %> (PDF)</span><% } %></a><% }) %></div>
  <p class="small muted">Intake photos, the <%= cat.extraPhoto %>, proof of ownership and any fault photos from inspection — kept so the condition at intake is on record when the item is returned or sold.</p>
</div>
<div class="panel"><h2>Loans</h2>
  <% if (!loans.length) { %><div class="empty">Not yet on a loan.</div><% } else { %><table><tr><th>Loan</th><th>Schedule no.</th><th>Grade</th><th class="num">Assessed</th><th class="num">Max loan</th><th>Status</th></tr>
  <% loans.forEach(function (l) { %><tr><td><a href="/loans/<%= l.id %>"><%= l.loan_no %></a></td><td><%= l.schedule_no %></td><td><%= l.grade || '—' %></td><td class="num"><%= K(l.assessed_value) %></td><td class="num"><%= K(l.max_loan) %></td><td><%- include('../partials/badge', { s: l.status }) %></td></tr><% }) %></table><% } %>
</div>
<div class="panel"><h2>Every movement</h2>
  <table><tr><th>When</th><th>From</th><th>To</th><th>Status</th><th>Reason</th><th>By</th></tr>
  <% movements.forEach(function (m) { %><tr><td class="nowrap"><%= fts(m.moved_at) %></td><td><%= m.from_location || '—' %></td><td><%= m.to_location %></td><td><%= (m.from_status || '') && CUSTODY[m.from_status] + ' → ' %><%= CUSTODY[m.to_status] %></td><td><%= m.reason %></td><td><%= m.by_name || 'system' %></td></tr><% }) %></table>
  <% if (viewings.length) { %><h3>Yard viewings</h3><table><tr><th>When</th><th>Visitor</th><th>Staff present</th><th>Note</th></tr><% viewings.forEach(function (v) { %><tr><td><%= fts(v.at) %></td><td><%= v.visitor %></td><td><%= v.staff_name %></td><td><%= v.note %></td></tr><% }) %></table><% } %>
</div>
<%- include('../partials/footer') %>
