<%- include('partials/header') %>
<div class="pagehead"><h1>Notifications</h1><form method="post" action="/notifications/read"><%- include('partials/csrf') %><button class="btn secondary small">Mark all read</button></form></div>
<% if (!list.length) { %><div class="panel empty">No notifications.</div><% } %>
<% list.forEach(function (n) { %>
<div class="panel" style="<%= n.is_read ? 'opacity:.65' : 'border-left:4px solid var(--accent)' %>;padding:.6rem .9rem;margin-bottom:.5rem">
  <form method="post" action="/notifications/read" style="display:flex;justify-content:space-between;gap:1rem;align-items:center"><%- include('partials/csrf') %><input type="hidden" name="id" value="<%= n.id %>">
  <div><strong><%= n.title %></strong><div class="small"><%= n.body %></div><div class="small muted"><%= fts(n.created_at) %></div></div>
  <% if (n.link) { %><button class="btn small secondary">Open</button><% } %></form>
</div>
<% }) %>
<%- include('partials/footer') %>
