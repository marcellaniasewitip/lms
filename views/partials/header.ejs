<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · <%= lender %></title>
<link rel="stylesheet" href="/static/css/app.css">
</head>
<body data-idle="<%= idleMinutes %>" data-auth="<%= user ? 1 : 0 %>">
<% if (user) { %>
<header class="top">
  <button type="button" class="navtoggle" data-nav-toggle aria-label="Open the menu" aria-expanded="false"><%- icon('menu', 22) %></button>
  <a class="brand" href="/"><span class="logo"><%= lender.charAt(0) %></span><span><%= lender %><small>Loan Management System</small></span></a>
  <form class="lookup" action="/lookup" method="get"><%- icon('search', 16) %><input name="q" placeholder="Scan a tag, ticket or bin, or search a customer…" aria-label="Scan or search"></form>
  <span class="spacer"></span>
  <a class="topbtn bell" href="/notifications" title="Notifications"><%- icon('bell', 20) %><% if (unread) { %><b><%= unread > 99 ? '99+' : unread %></b><% } %></a>
  <span class="who"><span class="avatar"><%= user.full_name.split(' ').map(function (w) { return w[0]; }).slice(0, 2).join('') %></span><span><strong><%= user.full_name %></strong><small><%= ROLE_LABEL[user.role] %> · <%= fd(today) %></small></span></span>
  <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="topbtn" title="Sign out"><%- icon('logout', 20) %><span class="hide-sm">Sign out</span></button></form>
</header>
<div class="shell">
<div class="navshade" data-nav-toggle></div>
<nav class="side" aria-label="Main menu">
  <% const SUBS = ['/loans/redeem', '/stock/access', '/archive/expiring', '/archive/deleted'];
     const isOn = (href) => href === '/' ? path === '/' : path.startsWith(href) && !SUBS.some((sub) => sub !== href && sub.startsWith(href) && path.startsWith(sub));
     const L = (href, ic, label) => `<a href="${href}" class="${isOn(href) ? 'on' : ''}">${icon(ic)}<span>${label}</span></a>`; %>
  <form class="navsearch" action="/lookup" method="get"><%- icon('search', 16) %><input name="q" placeholder="Scan or search…" aria-label="Scan or search"></form>
  <%- L('/', 'home', 'Dashboard') %>
  <h4>Counter</h4>
  <%- L('/customers', 'users', 'Customers') %>
  <%- L('/loans', 'file', 'Loans') %>
  <% if (is('loan_officer')) { %><%- L('/loans/redeem', 'redeem', 'Redemption') %><% } %>
  <%- L('/items', 'package', 'Item store') %>
  <% if (is('loan_officer', 'admin')) { %><%- L('/payments/unmatched', 'inbox', 'Payments to match') %><% } %>
  <%- L('/payments/refunds', 'money', 'Refunds & surplus') %>
  <%- L('/payments/reversals', 'undo', 'Reversals') %>
  <%- L('/tasks', 'phone', 'Call tasks') %>
  <h4>Custody</h4>
  <%- L('/bins', 'grid', 'Bins (Bin #)') %>
  <%- L('/stock', 'clipboard', 'Stock counts') %>
  <%- L('/stock/access', 'key', 'Store access log') %>
  <%- L('/sales', 'tag', 'Forfeited items / sales') %>
  <% if (is('admin', 'cro')) { %>
  <h4>Archive</h4>
  <%- L('/archive', 'search', 'Archive search') %>
  <%- L('/archive/expiring', 'clock', 'Expiring loans') %>
  <%- L('/archive/deleted', 'trash', 'Deletion log') %>
  <% } %>
  <h4>Oversight</h4>
  <%- L('/reports', 'chart', 'Reports') %>
  <% if (is('admin', 'cro')) { %><%- L('/aml', 'alert', 'AML flags') %><%- L('/admin/audit', 'list', 'Audit log') %><%- L('/admin/watchlists', 'shield', 'Flagged items & sanctions') %><% } %>
  <% if (is('admin')) { %>
  <h4>Admin</h4>
  <%- L('/admin/users', 'user', 'Users') %>
  <%- L('/admin/branches', 'pin', 'Branches') %>
  <%- L('/admin/settings', 'sliders', 'Settings & rates') %>
  <%- L('/admin/lists', 'layers', 'ID types & brands') %>
  <%- L('/admin/system', 'server', 'Nightly job & backups') %>
  <%- L('/admin/sms', 'message', 'SMS outbox') %>
  <h4>Account</h4>
  <%- L('/account/password', 'lock', 'Change password') %>
  <% } %>
</nav>
<main>
<% } else { %>
<main class="login">
<% } %>
<%- include('flash') %>
