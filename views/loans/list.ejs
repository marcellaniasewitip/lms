<%- include('../partials/header') %>
<div class="pagehead"><h1>Loans</h1><% if (is('loan_officer')) { %><a class="btn secondary" href="/loans/redeem">Redeem — scan ticket</a><% } %></div>
<form class="panel f" method="get"><div class="row">
  <div><label>Status</label><select name="status">
    <option value="">All active-system loans</option><option value="open" <%= st === 'open' ? 'selected' : '' %>>Released and open</option><option value="applications" <%= st === 'applications' ? 'selected' : '' %>>Applications</option>
    <% Object.entries(STATUS).filter(function ([k]) { return k !== 'archived' && k !== 'expired'; }).forEach(function ([k, v]) { %><option value="<%= k %>" <%= st === k ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
  <div><label>Loan number, customer name or number</label><input name="q" value="<%= query.q || '' %>"></div>
  <% if (is('loan_officer')) { %><div><label>&nbsp;</label><label class="check"><input type="checkbox" name="mine" value="1" <%= query.mine ? 'checked' : '' %>> My loans only</label></div><% } %>
</div><div class="actions"><button class="btn">Filter</button></div></form>
<div class="tablewrap"><table>
<thead><tr><th>Loan</th><th>Customer</th><th>Officer</th><th>Status</th><th>Applied</th><th>Released</th><th>Maturity</th><th class="num">Rate</th><th class="num">Amount</th><th class="num">Owing today</th></tr></thead><tbody>
<% if (!list.length) { %><tr><td colspan="10" class="empty">No loans.</td></tr><% } %>
<% list.forEach(function (l) { %><tr>
<td><a href="/loans/<%= l.id %>"><%= l.loan_no %></a></td><td><%= l.customer_name %><div class="small muted"><%= l.customer_no %></div></td><td class="small"><%= l.officer %></td>
<td><%- include('../partials/badge', { s: l.status }) %></td><td><%= fd(l.application_date) %></td><td><%= fd(l.release_date) %></td><td><%= fd(l.maturity_date) %></td>
<td class="num"><%= l.weekly_rate ? l.weekly_rate + '%' : '' %></td><td class="num"><%= K(l.amount_released || l.approved_amount || l.requested_amount) %></td>
<td class="num"><%= ['active','in_grace'].includes(l.status) ? K(l.owing) : '' %></td></tr><% }) %>
</tbody></table></div>
<%- include('../partials/footer') %>
