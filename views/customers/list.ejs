<%- include('../partials/header') %>
<div class="pagehead"><h1>Customers</h1><% if (is('loan_officer')) { %><a class="btn" href="/customers/new">Register customer</a><% } %></div>
<form class="panel f" method="get" style="display:flex;gap:.5rem;align-items:end">
  <div style="flex:1"><label>Search by name, customer number, mobile or ID number</label><input name="q" value="<%= q %>" autofocus></div>
  <button class="btn">Search</button>
</form>
<div class="tablewrap"><table>
<thead><tr><th>Customer</th><th>Name</th><th>Born</th><th>Mobile</th><th>Status</th><th>Verification</th><th>Risk</th></tr></thead>
<tbody>
<% if (!list.length) { %><tr><td colspan="7" class="empty">No customers found.</td></tr><% } %>
<% list.forEach(function (c) { %>
<tr><td><a href="/customers/<%= c.id %>"><%= c.customer_no %></a></td><td><%= c.surname %>, <%= c.given_names %></td><td><%= fd(c.dob) %></td>
<td class="nowrap"><%= fmtPhone(c.mobile) %><div class="small muted"><%= c.mobile_network %></div></td><td><%- include('../partials/badge', { s: c.status }) %></td><td><%- include('../partials/badge', { s: c.verification_status }) %></td><td><%= c.risk_grade %></td></tr>
<% }) %>
</tbody></table></div>
<%- include('../partials/footer') %>
