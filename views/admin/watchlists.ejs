<%- include('../partials/header') %>
<div class="pagehead"><h1>Flagged items and sanctions list</h1></div>
<div class="panel"><h2 style="margin-top:0">Flagged (stolen) items</h2><p class="small muted">The system blocks any item whose serial number, IMEI, VIN, engine number or plate is on this list. The CRO checks doubtful items with police before accepting.</p>
<form method="post" action="/admin/stolen" class="f"><%- include('../partials/csrf') %><div class="row"><div><label>Type</label><select name="number_type"><option>IMEI</option><option>Serial</option><option>VIN</option><option>Engine</option><option>Plate</option></select></div><div><label>Number</label><input name="number" required></div><div><label>Description</label><input name="description"></div><div><label>Source (e.g. police report no.)</label><input name="source"></div></div><div class="actions"><button class="btn small">Add to flagged list</button></div></form>
<table><tr><th>Type</th><th>Number</th><th>Description</th><th>Source</th><th>Added</th><th></th></tr><% stolen.forEach(function (s) { %><tr><td><%= s.number_type %></td><td class="mono"><%= s.number_norm %></td><td><%= s.description %></td><td><%= s.source %></td><td class="small"><%= s.full_name %> <%= fts(s.created_at) %></td><td><% if (s.active) { %><form method="post" action="/admin/stolen" class="inline"><%- include('../partials/csrf') %><input type="hidden" name="id" value="<%= s.id %>"><button class="btn small secondary">Remove</button></form><% } else { %>removed<% } %></td></tr><% }) %></table></div>
<div class="panel" id="sanctions"><h2 style="margin-top:0">Sanctions list</h2><p class="small muted">New customers are checked against this list at onboarding. A match raises an AML flag that must be cleared before any loan.</p>
<% if (is('admin')) { %><form method="post" action="/admin/sanctions" class="f"><%- include('../partials/csrf') %><div class="row"><div><label>Full name</label><input name="full_name" required></div><div><label>Date of birth</label><input name="dob" placeholder="DD/MM/YYYY"></div><div><label>Source list</label><input name="source" placeholder="e.g. UN Security Council"></div></div><div class="actions"><button class="btn small">Add</button></div></form><% } %>
<table><tr><th>Name</th><th>Born</th><th>Source</th><th></th></tr><% sanctions.forEach(function (s) { %><tr><td><%= s.full_name %></td><td><%= fd(s.dob) %></td><td><%= s.source %></td><td><% if (is('admin')) { %><form method="post" action="/admin/sanctions" class="inline"><%- include('../partials/csrf') %><input type="hidden" name="id" value="<%= s.id %>"><button class="btn small secondary">Remove</button></form><% } %></td></tr><% }) %></table></div>
<%- include('../partials/footer') %>
