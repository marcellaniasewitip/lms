<%- include('../partials/header') %>
<div class="pagehead"><div><h1>Branches</h1><div class="muted">Each branch has its own item store; every loan and item carries its branch. Branch details print on the pledge ticket.</div></div></div>
<% list.concat([{}]).forEach(function (b) { %>
<form method="post" action="/admin/branches" class="panel f"><%- include('../partials/csrf') %><input type="hidden" name="id" value="<%= b.id || '' %>">
<h3 style="margin-top:0"><%= b.id ? b.name : 'Add branch' %></h3><div class="row">
<div><label>Code</label><input name="code" value="<%= b.code || '' %>" required></div><div><label>Name</label><input name="name" value="<%= b.name || '' %>" required></div>
<div><label>Phone (+675)</label><input name="phone" value="<%= b.phone || '' %>"></div><div><label>Email</label><input name="email" value="<%= b.email || '' %>"></div>
<div><label>Postal address</label><input name="postal_address" value="<%= b.postal_address || '' %>"></div><div><label>Physical address (where goods are redeemed)</label><input name="physical_address" value="<%= b.physical_address || '' %>"></div>
<% if (b.id) { %><div><label>Active</label><select name="active"><option value="1">Active</option><option value="0" <%= b.active ? '' : 'selected' %>>Closed</option></select></div><% } %>
</div><div class="actions"><button class="btn small">Save</button></div></form>
<% }) %>
<%- include('../partials/footer') %>
