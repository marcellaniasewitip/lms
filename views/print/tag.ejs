<!doctype html><html><head><meta charset="utf-8"><title><%= title %></title>
<style>body{font-family:Arial,sans-serif;margin:1rem} .tag{border:1px dashed #333;padding:.6rem;width:7.5cm;text-align:center} .tag img{max-width:100%;height:60px} .s{font-size:11px}</style>
<link rel="stylesheet" href="/static/css/app.css"></head>
<body style="background:#fff">
<div class="tag"><img src="/items/<%= it.id %>/tag.png" alt="<%= it.item_no %>"><div><strong><%= it.item_no %></strong></div>
<div class="s"><%= it.brand_name %> <%= it.model %> · <%= it.location %></div><div class="s"><%= lender %> · in <%= fd(it.date_in) %></div></div>
<p class="noprint"><button class="btn" data-print>Print</button></p>
<script src="/static/js/app.js"></script>
</body></html>
