<!doctype html><html lang="en"><head><meta charset="utf-8"><title><%= title %></title>
<link rel="stylesheet" href="/static/css/app.css">
<style>
  body { background:#fff; font-size: 12px; }
  .sheet { max-width: 800px; margin: 0 auto 2rem; border: 1px solid #000; padding: 14px 18px; position: relative; page-break-after: always; }
  .sheet h1 { font-size: 20px; margin: 0; } .sheet h2 { font-size: 13px; margin: 10px 0 4px; border-bottom: 1px solid #000; text-transform: uppercase; letter-spacing: .04em; }
  .hdr { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .copy { font-weight: 700; border: 1px solid #000; padding: 2px 6px; font-size: 11px; }
  table.t { width: 100%; border-collapse: collapse; } table.t td, table.t th { border: 1px solid #555; padding: 3px 5px; font-size: 11.5px; background: #fff; }
  table.t th { width: 32%; text-transform: none; letter-spacing: 0; color: #000; background: #f2f2f2; }
  ol.terms { margin: 4px 0 4px 18px; padding: 0; } ol.terms li { margin-bottom: 2px; }
  .sig { display: flex; gap: 24px; margin-top: 14px; } .sig div { flex: 1; border-top: 1px solid #000; padding-top: 3px; }
  .stamp { position: absolute; top: 38%; left: 8%; right: 8%; text-align: center; font-size: 64px; font-weight: 800; color: rgba(170,0,0,.22); transform: rotate(-14deg); pointer-events: none; letter-spacing: .1em; }
  .stamp-top { background:#fff; text-align:center; font-weight:800; letter-spacing:.1em; position: static; transform: none; font-size: 22px; color: #a00; border: 3px solid #a00; margin-bottom: 6px; }
  .note { font-style: italic; }
  /* Pledge ticket laid out like the printed document */
  .pt { font-family: Arial, Helvetica, sans-serif; font-size: 10px; line-height: 1.22; border: 0; padding: 4px 8px; }
  .pt .copyline { text-align: right; font-size: 10px; margin-bottom: 4px; }
  .pt .brand { text-align: center; margin-top: 4px; }
  .pt .brand { display: block; text-align: center; white-space: nowrap; }
  .pt .bname { font-size: 26px; font-weight: 800; letter-spacing: .5px; text-transform: uppercase; }
  .pt .bar { font-size: 26px; margin: 0 8px; }
  .pt .slogan { font-size: 21px; font-style: italic; }
  .pt .ptitle { text-align: center; font-size: 13px; font-weight: 600; margin-top: 4px; }
  .pt .psub { text-align: center; font-size: 12px; margin-bottom: 6px; }
  .pt .block { display: grid; grid-template-columns: 100px 1fr; gap: 2px 10px; margin: 5px 0; }
  .pt .bl { font-size: 13px; }
  .pt .kv2 { display: grid; grid-template-columns: 130px 1fr; gap: 0 14px; font-size: 11px; }
  .pt .rule { border-top: 3px solid #000; margin: 8px 0; }
  .pt .rule.thin { border-top-width: 1px; }
  .pt .money { display: grid; grid-template-columns: 1fr 1fr; gap: 0 40px; font-size: 12px; }
  .pt .money.small2 { font-size: 11px; align-items: end; margin-top: 6px; }
  .pt .kv3 { display: grid; grid-template-columns: 1fr auto; gap: 3px 10px; }
  .pt .r { text-align: right; }
  .pt ol.pterms { margin: 6px 0 4px 20px; padding: 0; } .pt ol.pterms li { margin-bottom: 1px; }
  .pt .pconf { margin: 4px 0 0 20px; }
  .pt .psum { margin-top: 4px; }
  .pt ul.pdash { list-style: none; margin: 2px 0 2px 36px; padding: 0; } .pt ul.pdash li::before { content: '– '; margin-left: -14px; }
  .pt .sigs { display: flex; justify-content: space-between; gap: 60px; margin-top: 26px; font-size: 11.5px; }
  .pt .sigs > div { flex: 1; } .pt .sigs .line { border-top: 1px solid #000; margin-bottom: 4px; }
  .pt .sched { margin-top: 6px; font-size: 11.5px; position: relative; }
  .pt .sched ul { margin: 2px 0 6px 18px; padding: 0; }
  .pt .sched .barcode { position: absolute; right: 0; top: 0; } .pt .sched .barcode img { height: 46px; }
  .pt .expired-mark { position: absolute; right: 24px; top: 6px; font-size: 26px; font-weight: 800; color: #a00; border: 3px solid #a00; padding: 0 8px; transform: rotate(-8deg); }
  @page { size: A4; margin: 10mm; }
  @media print { .noprint { display: none; } .sheet { border: 1px solid #000; } .sheet.pt { border: 0; margin: 0; max-width: none; } }
</style></head><body<%= autoPrint ? ' data-autoprint="1"' : '' %>>
<div class="noprint" style="max-width:800px;margin:1rem auto;display:flex;gap:.6rem;align-items:center;flex-wrap:wrap"><button class="btn" data-print>Print pledge ticket</button> <a class="btn secondary" href="/loans/<%= l.id %>/ticket/pdf">Download PDF</a> <a class="btn secondary" href="/loans/<%= l.id %>">Back to the loan</a>
<span class="small muted">Prints two copies (customer and lender), each with its Disclosure Statement. Both are signed by the customer and the Loan Officer; the lender's signed copy is scanned into the loan.</span>
<% if (preview) { %><span class="alert alert-warn" style="display:inline-block;margin:0;padding:.3rem .6rem">For signing today: the contract date is today. Release the money today after both have signed.</span><% } %></div>
<% const t0 = fig.terms; const cur = current; const expired = t && t.status === 'expired'; const replacement = t && t.kind === 'replacement';
   const pick = function (k) { return (t0[k] && t0[k].length ? t0[k] : cur[k]) || []; };
   const months = t0.term_months || cur.term_months;
   const terms = pick('pledge_terms').map(function (x) { return x.replace(/\{months\}/g, months); });
   const CAT = { phone: 'ELECTRONIC PHONE', laptop: 'ELECTRONIC LAPTOP', car: 'MOTOR VEHICLE' };
   const addr = [c.addr_section_lot, c.addr_town, c.addr_district, c.addr_province].filter(Boolean).join(', ');
   ['PLEDGER\'S COPY', 'LENDER\'S COPY — signed and scanned into the loan'].forEach(function (copy) { %>
<div class="sheet pt">
  <% if (expired) { %><div class="expired-mark">EXPIRED</div><% } %>
  <% if (replacement) { %><div class="stamp">REPLACEMENT</div><% } %>
  <div class="copyline noprint"><span class="copy"><%= copy %></span><% if (t) { %> Ticket <%= t.ticket_no %> v<%= t.version %><%= replacement ? ' (Replacement)' : '' %><% } %></div>
  <div class="brand"><span class="bname"><%= cur.ticket_brand || cur.lender_name %></span><% if (cur.lender_slogan) { %><span class="bar">|</span><span class="slogan"><%= cur.lender_slogan %></span><% } %></div>
  <div class="ptitle">PLEDGE TICKET FOR GOODS DETAILS IN SCHEDULE 1 – ATTACHED ("the Goods")</div>
  <div class="psub">Required by the Pawnbrokers Act 1951 ("PBA")</div>

  <div class="block">
    <div class="bl">Our details</div>
    <div class="kv2">
      <span>Name:</span><span><%= branch.name %> ("we", "us", "our")</span>
      <span>Phone:</span><span><%= branch.phone %></span>
      <span>Email:</span><span><%= branch.email %></span>
      <span>Postal Address:</span><span><%= branch.postal_address %><br><em>This is where you can redeem your goods.</em></span>
      <span>Physical Address:</span><span><%= branch.physical_address %></span>
    </div>
  </div>

  <div class="block">
    <div class="bl">Your details</div>
    <div class="kv2">
      <span>Postal Address:</span><span><%= c.po_box || '—' %></span>
      <span>Name:</span><span><%= c.given_names %> <%= c.surname %></span>
      <span>Residential:</span><span><%= addr %></span>
      <span>Phone:</span><span><%= fmtPhone(c.mobile) %></span>
      <span>ID:</span><span><%= idText %></span>
      <span>Date of Birth:</span><span><%= fd(c.dob) %> <em>(Note you must be 18 years or over to pledge goods)</em></span>
    </div>
  </div>
  <div class="rule"></div>

  <div class="money">
    <div class="kv3">
      <span>Amount Advanced</span><span class="r"><%= K(fig.amount) %></span>
      <span>Redemption Fee</span><span class="r"><%= K(fig.weeklyCharge) %></span>
      <span>Amount Payable at Redemption<br>(Redemption Price)</span><span class="r"><strong><%= K(fig.price) %></strong></span>
    </div>
    <div class="kv3">
      <span>Contract Number</span><span class="r"><strong><%= l.loan_no %></strong></span>
      <span>Contract Date</span><span class="r"><%= fd(fig.release) %></span>
      <span>Redemption Date</span><span class="r"><strong><%= fd(fig.redemptionDate) %></strong></span>
    </div>
  </div>
  <div class="money small2">
    <div>A lesser amount may be payable if you redeem the Goods before the Redemption Date. <%= fd(fig.redemptionDate) %></div>
    <div class="kv3"><span>Redemption Period</span><span class="r"><%= months %> months</span></div>
  </div>
  <div class="rule thin"></div>

  <ol class="pterms"><% terms.forEach(function (x) { %><li><%= x %></li><% }) %></ol>
  <div class="pconf">By signing below, you agree and confirm:</div>
  <ol class="pterms"><% pick('pledge_confirmations').forEach(function (x) { %><li><%= x %></li><% }) %></ol>
  <div class="psum"><em>Summary of Rights of Pledgers and Obligations of Pawnbrokers under the pledge, as provided by the PBA</em></div>
  <div class="pconf">Rights of Pledgers</div>
  <ul class="pdash"><% pick('pledge_rights').forEach(function (x) { %><li><%= x %></li><% }) %></ul>
  <div class="pconf">Obligations of Pawnbrokers</div>
  <ul class="pdash"><% pick('pledge_obligations').forEach(function (x) { %><li><%= x %></li><% }) %></ul>

  <div class="sigs">
    <div><div class="line"></div>Signed by: <%= c.given_names %> <%= c.surname %></div>
    <div><div class="line"></div>Signed by: <%= officer %></div>
  </div>

  <div class="sched">
    <div><em>Schedule 1 – The Goods</em></div>
    <% lis.forEach(function (i) { const acc = JSON.parse(i.accessories || '[]'); %>
    <div class="itemno">Item number <%= i.schedule_no %></div>
    <ul>
      <li><%= CAT[i.category] %>, <%= i.brand_name %> <%= i.model %><%= i.category === 'car' ? (i.year ? ', ' + i.year : '') + (i.colour ? ', ' + i.colour : '') + ', odometer ' + Number(i.mileage_intake).toLocaleString() + ' km' : (i.storage ? ', ' + i.storage : '') + (i.ram ? ', ' + i.ram + ' RAM' : '') + (i.processor ? ', ' + i.processor : '') %></li>
      <li><%= i.category === 'car' ? 'VIN: ' + i.vin + ', Engine: ' + i.engine_no + ', Plate: ' + i.plate : i.imei ? 'IMEI: ' + i.imei : 'SN: ' + i.serial_no %></li>
      <li><%= acc.length ? 'Comes with ' + acc.join(', ') : 'No accessories' %><%= i.category === 'car' ? '' : ' and pw: ' + i.password %></li>
    </ul>
    <% }) %>
    <div class="barcode"><img src="/loans/<%= l.id %>/barcode.png" alt="<%= l.loan_no %>"></div>
  </div>
</div>

<div class="sheet">
  <% if (expired) { %><div class="stamp-top">EXPIRED</div><% } %>
  <div class="hdr"><div><h1>Disclosure Statement</h1><div>Contract <%= l.loan_no %> · <%= current.lender_name %></div></div><span class="copy"><%= copy %></span></div>
  <table class="t" style="margin-top:8px">
    <tr><th>Amount advanced</th><td><%= K(fig.amount) %></td></tr>
    <tr><th>Weekly interest rate</th><td><%= l.weekly_rate %>% a week on the principal still owed (set by the item's quality grade <%= l.rate_grade %>)</td></tr>
    <tr><th>Interest for a full week on the amount advanced</th><td><%= K(fig.weeklyCharge) %></td></tr>
    <% if (bank.any) { %><tr><th>Where to pay</th><td>Cash at <%= branch.name %>, or bank deposit / mobile transfer to <%= bank.text %>, quoting contract number <%= l.loan_no %>.</td></tr><% } %>
    <tr><th>Fees</th><td><% const fl = JSON.parse(l.fee_lines || '[]'); %><%= fl.length ? fl.map(function (f) { return f.name + ' ' + K(f.amount); }).join('; ') : 'None' %></td></tr>
    <tr><th>Redemption price if nothing is paid before <%= fd(fig.redemptionDate) %></th><td><strong><%= K(fig.price) %></strong></td></tr>
    <tr><th>Maturity (redemption) date</th><td><%= fd(fig.redemptionDate) %> — no renewals or extensions</td></tr>
    <tr><th>Grace period</th><td><%= t0.grace_days %> days to <%= fd(fig.graceEnd) %>; interest keeps being added each week</td></tr>
    <tr><th>If not paid by the grace end date</th><td>The goods are forfeited and sold at a public internet auction (or by other reasonable means). Any surplus over the amount owing is paid to you as section 19 of the Pawnbrokers Act 1951 requires.</td></tr>
    <tr><th>Example of early redemption</th><td>Paying in full after 2 weeks with no part payments costs <%= K(fig.amount + 2 * fig.weeklyCharge + fig.fees) %>.</td></tr>
  </table>
  <p style="margin-top:8px"><%= t0.disclosure_extra %></p>
  <div class="sig"><div>Pledger signature</div><div>Lender's officer: <%= officer %></div></div>
</div>
<% }) %>
<script src="/static/js/app.js"></script>
</body></html>
