<%- include('../partials/header') %>
<div class="pagehead"><div><h1>AML flags</h1><div class="muted">Identity checks at onboarding, sanctions screening and unusual activity (large cash payouts or repayments, repeated high-value items). Suspicious transactions are reported to the Financial Analysis and Supervision Unit (FASU) at the Bank of Papua New Guinea, as the AML/CTF Act 2015 requires.</div></div></div>
<details class="action panel" style="padding:0"><summary>Raise a suspicion manually</summary><div><form method="post" action="/aml" class="f"><%- include('../partials/csrf') %><div class="row"><div><label>Customer number (optional)</label><input name="customer_no"></div></div><label>What is suspicious</label><textarea name="details" required></textarea><div class="actions"><button class="btn small">Raise flag</button></div></form></div></details>
<div class="tablewrap"><table><thead><tr><th>Flagged</th><th>Type</th><th>Customer</th><th>Loan</th><th>Details</th><th>Status</th><th>Review</th></tr></thead><tbody>
<% if (!list.length) { %><tr><td colspan="7" class="empty">No flags.</td></tr><% } %>
<% list.forEach(function (f) { %><tr><td class="nowrap small"><%= fts(f.created_at) %></td><td><%= TYPES[f.type] || f.type %></td><td><% if (f.customer_id) { %><a href="/customers/<%= f.customer_id %>"><%= f.customer_no %></a> <%= f.name %><% } %></td><td><% if (f.loan_id) { %><a href="/loans/<%= f.loan_id %>"><%= f.loan_no %></a><% } %></td><td class="small"><%= f.details %></td><td><%- include('../partials/badge', { s: f.status }) %></td>
<td class="small"><% if (f.status === 'open') { %><form method="post" action="/aml/<%= f.id %>/review" class="f"><%- include('../partials/csrf') %><select name="status"><option value="cleared">Cleared — not suspicious</option><option value="reported">Reported to FASU</option></select><input name="note" placeholder="Review note" required><input name="fasu_ref" placeholder="FASU STR reference (if reported)"><button class="btn small">Save</button></form><% } else { %><%= f.reviewer %> <%= fts(f.reviewed_at) %>: <%= f.review_note %><%= f.fasu_ref ? ' · FASU ' + f.fasu_ref : '' %><% } %></td></tr><% }) %>
</tbody></table></div>
<%- include('../partials/footer') %>
