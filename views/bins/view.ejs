<%- include('../partials/header') %>
<div class="pagehead"><div><h1><%= label %></h1><div class="muted"><%= KINDS[b.kind].label %> · <%= branch %> · <%= KINDS[b.kind].for %><%= b.description ? ' · ' + b.description : '' %> · <%= items.length %> item(s)<%= b.capacity ? ' of ' + b.capacity : '' %><%= b.active ? '' : ' · CLOSED' %></div></div>
<a class="btn secondary" href="/bins">All bins</a></div>
<div class="tablewrap"><table><thead><tr><th>Tag</th><th>Item</th><th>Customer</th><th>Loan</th><th>Status</th><th>Received</th></tr></thead><tbody>
<% if (!items.length) { %><tr><td colspan="6" class="empty">This bin is empty.</td></tr><% } %>
<% items.forEach(function (i) { %><tr><td><a href="/items/<%= i.id %>"><%= i.item_no %></a></td><td><%= i.brand_name %> <%= i.model %><div class="small muted"><%= i.category %><%= b.kind === 'key' ? ' — keys and papers for ' + (i.plate || '') : '' %></div></td>
<td><%= i.customer_name %></td><td><% if (i.loan_no) { %><a href="/loans/<%= i.current_loan_id %>"><%= i.loan_no %></a> <%- include('../partials/badge', { s: i.loan_status }) %><% } %></td>
<td><%- include('../partials/badge', { s: i.custody_status }) %></td><td><%= fd(i.date_in) %></td></tr><% }) %>
</tbody></table></div>
<% if (is('admin')) { %>
<form method="post" action="/bins/<%= b.id %>" class="panel f" style="margin-top:1rem"><%- include('../partials/csrf') %><h2 style="margin-top:0">Edit bin</h2><div class="row">
<div><label>Capacity</label><input name="capacity" value="<%= b.capacity || '' %>" placeholder="blank = no limit"></div><div><label>Description</label><input name="description" value="<%= b.description || '' %>"></div>
<div><label>Status</label><select name="active"><option value="1">Open</option><option value="0" <%= b.active ? '' : 'selected' %>>Closed (must be empty)</option></select></div></div>
<div class="actions"><button class="btn small">Save</button></div></form>
<% } %>
<%- include('../partials/footer') %>
