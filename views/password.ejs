<%- include('partials/header') %>
<div class="panel" style="max-width:480px">
  <h1>Change password</h1>
  <% if (user.must_change_pw) { %><div class="alert alert-info">Please choose your own password before continuing.</div><% } %>
  <form method="post" action="/account/password" class="f" autocomplete="off">
    <%- include('partials/csrf') %>
    <label>Current password</label><input type="password" name="current" required>
    <label>New password</label><input type="password" name="next" required minlength="10">
    <label>Repeat new password</label><input type="password" name="confirm" required minlength="10">
    <p class="hint">At least 10 characters with upper and lower case, a number and a symbol.</p>
    <div class="actions"><button class="btn">Save password</button></div>
  </form>
</div>
<%- include('partials/footer') %>
